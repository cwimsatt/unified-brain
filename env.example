# unified-brain — settings.
# Copy this file to .env in the same folder as codebase_qa_service.py and
# next_claude.py.
#
# Part 1 is the configuration the benchmarks in benchmarks/ ran on; fill in
# the keys and you have our setup. Part 2 lists every other constant the
# code reads, with its default; leave them out unless you want to change one.
#
# Comments go on their own lines, or after a value and a space. Never after
# an empty value: python-dotenv reads "KEY=   # text" as the value "# text".

# ════════════════════════════════════════════════════════════════════════
# PART 1 — the benchmark configuration (For a quick start simply fill the keys in PART 1)
# ════════════════════════════════════════════════════════════════════════

# The repository's database file. `python next_claude.py /path/to/repo`
# writes /path/to/repo/.unified-brain.db; point the service at that file.
DB_PATH=/path/to/repo/.unified-brain.db

# Writer / judge model: writes the answers to questions and the verdict of
# every probe in a report. llmbase = DeepSeek V4.1 Flash on Fireworks; or anthropic.
LLM_PROVIDER=llmbase
LLM_API_KEY=<your_fireworks_key_HERE>

# Jev, the decision model: scores skills, follows names through the code,
# picks the same-commit changes the judge needs. Reached directly at
# Typesafe (JEV_PROVIDER=typesafe, TYPESAFE_API_KEY) or through OpenRouter
# (JEV_PROVIDER=openrouter, OPENROUTER_API_KEY — the benchmarks ran that
# way; same model). JEV_PROVIDER left out: typesafe when only
# TYPESAFE_API_KEY is set, else openrouter. On OpenRouter any model that
# answers the Decisions API can be named; the one alternative we measured
# (cloudflare/clef-flash) kept 2 of 16 seeds on our test question and its
# chains wandered — not recommended.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
#JEV_PROVIDER=openrouter
#OPENROUTER_API_KEY=
# The model: jev-1.13.0 at Typesafe, typesafe/jev-1.13 on OpenRouter. The
# default follows the provider; either name works with either provider.
#JEV_MODEL=jev-1.13.0

# Code vectors: qwen (Qwen3-Embedding-8B on DeepInfra; the benchmarks),
# voyage (Voyage code 4, about 20x the price; same answers on our tests),
# or none (no key: the ingest embeds nothing and Jev scores every skill of
# the repository for each question — more Jev calls per question).
# The ingest's embedding pass fills CODE_EMBED_PASS2; questions pre-filter
# with QA_VECTOR_STORE. Keep both the same. Left out, each takes the store
# whose key is set (qwen before voyage), else none.
CODE_EMBED_PASS2=qwen
QA_VECTOR_STORE=qwen
DEEPINFRA_API_KEY=
VOYAGE_API_KEY=

# Chains. JEV_HIT_TRIAGE=1: when a followed name is found in several places,
# Jev first scans them in one call (coordinates + the lines around each
# occurrence, judged against each other) and only the places it would open
# are read in full — 3–8x fewer Jev calls on a large repository, same
# answers; 0 reads every place. JEV_NAMES_AS_CHOICE=1: the names of a body
# are offered to Jev as ONE choice question (a distribution over the names
# plus "none of these") instead of one yes/no question per name — about 5%
# fewer Jev tokens, same answers; a name is followed when it beats "none of
# these" and has at least half the best name's share. 0 restores one
# question per name.
JEV_HIT_TRIAGE=1
JEV_NAMES_AS_CHOICE=1



# ════════════════════════════════════════════════════════════════════════
# PART 2 — tuning constants (defaults shown run automatically through 
# the code, no need to uncomment; uncomment ONLY to experiment)
# ════════════════════════════════════════════════════════════════════════

# ── Ingest / embedding pass ────────────────────────────────────────────
# Files the ingest leaves out: comma-separated patterns (fnmatch) tried
# against the repository-relative path and against the file name, e.g.
# `fixtures/*,*.jsonl,Cargo.lock`. Empty = only the built-in skip list
# (dependency-manager trees and build caches; see SKIP_PATHS in ingester.py).
#UB_SKIP_GLOBS=
# Embedding batches sent at the same time.
#CODE_EMBED_PASS2_WORKERS=4

# ── Questions: embedding pre-filter ────────────────────────────────────
# Nearest skills by code vector that Jev then scores. If the vector search
# fails, Jev scores every skill instead. Kept seeds sat at ranks up to 380
# of 400 on our test questions; the log line "kept seeds at knn ranks"
# shows yours before you lower this.
#JEV_PREFILTER_TOP_K=400
# Cosine score a vector row needs to count (per store).
#MIN_SCORE_VOYAGE=0.35
#MIN_SCORE_QWEN=0.35
# Most vector rows read while collecting the nearest skills.
#CODE_KNN_MAX_ROWS=20000

# ── Questions: Jev scoring of the candidates ───────────────────────────
# Score (0–4) a skill needs to be kept.
#JEV_MIN_SCORE=2.0
# Most skills kept, and most characters of their bodies, for one question.
#JEV_MAX_SKILLS=60
#JEV_MAX_CHARS=300000
# Jev calls sent at the same time when scoring.
#JEV_CONCURRENCY=128
# Greps run at the same time inside a chain hop.
#JEV_GREP_CONCURRENCY=16

# ── Chains: Jev follows names out of the code (questions and probes) ───
# 0 switches the chains off for questions.
#JEV_EXPAND=1
# How many hops a chain may take from its start.
#JEV_EXPAND_MAX_HOPS=4
# Probability Jev must give a place (hit triage) or a name (when
# JEV_NAMES_AS_CHOICE=0) for it to be followed. 0.7 saved 8% of the chain
# cost on our broadest test question and lost the first and last stage of
# the answer; leave it at 0.5.
#JEV_FOLLOW_MIN=0.5
# A "reject" below this probability is treated as "continue" (not sure).
#JEV_SURE_REJECT=0.75
# Jev calls sent at the same time by the chain steps (JEV_CONCURRENCY is
# the scoring pass above). Left out, a JEV_CONCURRENCY you set applies to
# the chain steps as well.
#JEV_CHAIN_CONCURRENCY=64
# 1 = Jev is shown the code only, never a stored description of the skill
# (the local ingest stores none, so this changes nothing here). 0 shows them.
#JEV_NO_DESC=1
# Per question: most Jev calls, most bodies attached, most characters attached.
#JEV_EXPAND_BUDGET=300
#JEV_EXPAND_MAX_ADD=60
#JEV_EXPAND_MAX_CHARS=250000
# A name with more grep hits than this is "everywhere" and is not followed.
#JEV_EXPAND_MAX_HITS=25
# Most definitions of one name that are read.
#JEV_EXPAND_MAX_DEFS=4
# Most names taken from one body, and lines around the link they are taken from.
#JEV_EXPAND_PER_NODE=30
#JEV_EXPAND_WINDOW=10
# Most names offered to Jev from one body.
#JEV_FOLLOW_POOL=40
# Text one Jev call may hold. A longer body shows the part around the link.
#JEV_BODY_MAX_CHARS=60000
# Reached-but-not-read places listed as leads.
#JEV_LEADS_MAX=20
# Who judges each reached body: jev, or llm (the writer model; slower, costs more).
#CHAIN_JUDGE=jev
# Judge calls sent at the same time when CHAIN_JUDGE=llm.
#JUDGE_CONCURRENCY=16

# ── Probes (reports) ───────────────────────────────────────────────────
# Chains started from the changed lines: 3 = three chains, one search and
# one Jev call per chain and hop. 0 = the wide search (80 Jev calls per hop).
#PROBE_FAST_CHAINS=3
# Per probe: most Jev calls, most bodies attached by the chains.
#PROBE_FAST_CHAIN_BUDGET=80
#PROBE_FAST_CHAIN_ADD=15
# Same-commit changes are shown in full up to this many characters; above
# it, Jev reads them whole and picks the ones the judge needs.
#PROBE_FAST_COMMIT_CHARS=150000
# Changes per Jev pick call.
#PROBE_FAST_PICK_BATCH=40
# Evidence budget per probe; blocks that do not fit are dropped and named.
#PROBE_FAST_EVIDENCE_CHARS=300000
# Changed lines of the target put in the chain question.
#PROBE_FAST_QUESTION_DIFF_CHARS=6000
# Diff lines shown to the judge; a longer diff shows head and tail, marked.
#PROBE_DIFF_MAX_LINES=6000
# Reasoning effort of the judge call (provider dependent).
#PROBE_FAST_EFFORT=high
# A skill touched by more commits than this in the range gets one probe per commit.
#PROBE_SPLIT_THRESHOLD=1
# 1 = other members of the target's composites join the first hop (composites
# are not formed by the local ingest, so this does nothing here).
#PROBE_FAST_COMPOSITES=0
# Probes run at the same time during a report (the code allows at most 20).
#REPORT_CONCURRENCY=4
# Time limit of one probe re-run from the timeline page, in seconds.
#PROBE_TIMEOUT_SECONDS=1500
# Characters of each verdict's tail read by the cross-probe reconcile step.
#RECONCILE_TAIL_CHARS=1200
# A report's lease: another process may take it over this many seconds
# after the owner stops renewing.
#REPORT_LEASE_SECONDS=120

# ── Answers ────────────────────────────────────────────────────────────
# Output limit of the writer call (thinking tokens count against it).
#WRITER_MAX_TOKENS=120000

# ── Writer ─────────────────────────────────────────────────────────────
# Each LLM_PROVIDER has a built-in model and endpoint: llmbase =
# openai/accounts/fireworks/models/deepseek-v4p1-flash at
# https://api.fireworks.ai/inference/v1; anthropic = anthropic/claude-haiku-4-5.
# Override either here — e.g. another Fireworks model, or any other
# OpenAI-compatible endpoint with LLM_PROVIDER=llmbase.
#LLM_MODEL=
#LLM_API_BASE=
# litellm, the writer client, fetches its model price map from
# raw.githubusercontent.com when it is imported and falls back to its
# bundled copy when it cannot; True skips the fetch. The service imports
# litellm before it reads .env, so this one only works from the shell
# (export LITELLM_LOCAL_MODEL_COST_MAP=True), not from this file.
#LITELLM_LOCAL_MODEL_COST_MAP=True

# ── Jev endpoint ───────────────────────────────────────────────────────
# Each JEV_PROVIDER has a built-in endpoint: typesafe =
# https://api.typesafe.ai/v1/systemone, openrouter =
# https://openrouter.ai/api/alpha/decisions. Override the endpoint here, or
# the key whatever the provider (JEV_API_KEY wins over TYPESAFE_API_KEY and
# OPENROUTER_API_KEY).
#JEV_API_BASE=
#JEV_API_KEY=
# Price per million input tokens behind the Jev cost lines when the provider
# reports tokens but no cost (Typesafe); OpenRouter reports the cost itself.
#JEV_PRICE_PER_MTOK_IN=0.042

# ── Claims (/api/claims/evaluate, the evaluate_claims MCP tool) ────────
# Probability a polarity (supports / contradicts) needs to become evidence,
# and how close to the stronger polarity the weaker one may be and still be
# admitted too (Factbag's defaults: 0.4 and 0).
#CLAIMS_MIN_PROBABILITY=0.4
#CLAIMS_AMBIGUITY_MARGIN=0
# Longest passage Jev reads per call (characters; a longer body is split with
# an overlap) and most passages per evaluation (one Jev call per passage and
# claim).
#CLAIMS_PASSAGE_CHARS=8000
#CLAIMS_MAX_PASSAGES=60

# ── Service ────────────────────────────────────────────────────────────
# The service listens on http://127.0.0.1:PORT. The MCP config's
# UNIFIED_BRAIN_URL must match.
#PORT=8000
# Most rows one /api/grep call returns (its max_results is capped here).
#GREP_MAX_RESULTS=500
# A DB_PATH that does not exist or holds no commits stops the service at
# startup, with the fix in the message. 1 starts it anyway (tests; a service
# started before the first ingest).
#UB_ALLOW_EMPTY_DB=0
